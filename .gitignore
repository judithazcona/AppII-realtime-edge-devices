# --- Python / uv ---
.venv/
venv/
__pycache__/
*.py[cod]
.python-version
# keep pyproject.toml and uv.lock tracked
uv.toml

# --- Secrets: never commit these (public repo, rule 16) ---
.env
.env.*
*.key
*.pem
*.p12
*.crt
secrets.h
secrets.json
credentials.json
*_token*
# template pattern: commit wifi_credentials.example.h, never wifi_credentials.h
*_credentials.h
*_credentials.example.h.bak

# --- Raw IMU recordings and derived datasets (rule 16) ---
# recordings are CSV/JSON exports from the board at 50-100 Hz; keep them off the repo
data/raw/
data/windows/
data/features/
data/splits/
data/external/
*.csv.gz
*.parquet
*.npy
*.npz
*.h5
*.hdf5
# trained models and converted/embedded weights stay out too
*.pt
*.pth
*.joblib
*.pickle
*.onnx
*.tflite
*.ulp
*.bin

# --- Course material stays out of the public repo (rule 2) ---
docs/*.html
docs/**/*.html

# --- Full-resolution originals stay out; only the compressed photo is committed ---
docs/raw/

# --- Firmware build output ---
build/
.cxx/
cmake-build-*/
.sdkconfig
sdkconfig.*
managed_components/
dependencies.lock
partitions/*.bin
bootloader_signing_key.pem
.cache/
# arduino-cli compile output (keep the sketch + commands, not the artifacts)
*.elf
*.map
*.exe
firmware/build/
build/
sdkconfig.old
.menuconfig

# --- Logs, notebooks, tooling noise ---
*.log
*.tmp.txt
.ipynb_checkpoints/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
